# Polarion instance base URL (no trailing slash)
POLARION_URL=https://your-polarion-instance.com

# Bearer token for Polarion REST API
POLARION_TOKEN=your-personal-access-token

# Optional: client-side request rate cap (requests per second).
# Default 1 is a conservative floor; raise it to match what your instance
# allows, or set 0 to disable client-side pacing entirely. Writes keep a
# fixed post-write pause on top, which this cap does not lift.
# Read from the directory the server is launched from — export real env
# vars instead when an MCP client spawns the server for you.
#POLARION_MAX_REQUESTS_PER_SECOND=1
