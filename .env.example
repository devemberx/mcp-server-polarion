# Polarion instance base URL (no trailing slash)
POLARION_URL=https://your-polarion-instance.com

# Bearer token for Polarion REST API
POLARION_TOKEN=your-personal-access-token

# Optional: client-side request rate cap (requests per second).
# Default 1 is a conservative floor; raise it if your instance allows more,
# or set 0 to disable client-side pacing entirely.
#POLARION_MAX_REQUESTS_PER_SECOND=1
